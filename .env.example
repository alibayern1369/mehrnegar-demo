# Public site URL (canonical, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://mehrnegar.ir

# Google Search Console HTML tag verification value
GOOGLE_SITE_VERIFICATION=

# Google reCAPTCHA v3
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Landing CMS admin (default: 123). After first login you can change it in /admin.
MARKETING_ADMIN_PASSWORD=123
MARKETING_ADMIN_SECRET=
